# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# KBO sync cron (Phase 8.5)
# Used to authorize Vercel Cron / manual trigger calls to /api/cron/sync-kbo-*
CRON_SECRET=

# Gemini Vision (Phase 8.5 - 티켓 인증)
# Google AI Studio에서 발급: https://aistudio.google.com
GEMINI_API_KEY=

# Telegram 에러 알림 (선택)
# 셋업:
#   1. Telegram에서 @BotFather 검색 → /newbot → 봇 이름/유저네임 지정 → BOT_TOKEN 발급
#   2. 본인이 봇과 1:1 대화 시작 (또는 그룹에 봇 추가)
#   3. https://api.telegram.org/bot<BOT_TOKEN>/getUpdates 호출 → "chat":{"id":...} 추출
# 둘 다 비어 있으면 알림 비활성 (console.error만 출력).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
